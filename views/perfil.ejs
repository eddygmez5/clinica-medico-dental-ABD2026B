<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <div class="container pb-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <% if (mensaje) { %>
                        <div class="alert alert-success alert-dismissible fade show">
                            <%= mensaje %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <% } %>

                            <!-- TARJETA 1: DATOS PERSONALES / PROFESIONALES -->
                            <div class="card border-0 shadow-sm p-4 mb-4">
                                <h3 class="fw-bold mb-1">Mi Perfil Profesional</h3>
                                <p class="text-muted small mb-4">Rol asignado: <strong>
                                        <%= usuario.rol %>
                                    </strong></p>

                                <form action="/perfil" method="POST">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Nombre(s)</label>
                                            <input type="text" class="form-control" name="nombre"
                                                value="<%= perfil ? perfil.nombre : '' %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Apellido(s)</label>
                                            <input type="text" class="form-control" name="apellido"
                                                value="<%= perfil ? perfil.apellido : '' %>" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Sexo</label>
                                            <select class="form-select" name="sexo">
                                                <option value="Masculino" <%=(perfil && perfil.sexo==='Masculino' )
                                                    ? 'selected' : '' %>>Masculino</option>
                                                <option value="Femenino" <%=(perfil && perfil.sexo==='Femenino' )
                                                    ? 'selected' : '' %>>Femenino</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Teléfono</label>
                                            <input type="text" class="form-control" name="telefono"
                                                value="<%= perfil ? perfil.telefono : '' %>">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Correo de contacto</label>
                                            <input type="email" class="form-control" name="email"
                                                value="<%= perfil ? perfil.email : emailUsuario %>">
                                        </div>

                                        <% if (usuario.rol==='Medico' ) { %>
                                            <div class="col-md-6">
                                                <label class="form-label">Fecha de Nacimiento</label>
                                                <input type="date" class="form-control" name="fecha_nacimiento"
                                                    value="<%= (perfil && perfil.fecha_nacimiento) ? new Date(perfil.fecha_nacimiento).toISOString().split('T')[0] : '' %>">
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Especialidad</label>
                                                <select class="form-select" name="especialidad" required>
                                                    <option value="medicina_general" <%=(perfil &&
                                                        perfil.especialidad==='medicina_general' ) ? 'selected' : '' %>
                                                        >Medicina General</option>
                                                    <option value="odontologia_general" <%=(perfil &&
                                                        perfil.especialidad==='odontologia_general' ) ? 'selected' : ''
                                                        %>>Odontología General</option>
                                                    <option value="ortodoncia" <%=(perfil &&
                                                        perfil.especialidad==='ortodoncia' ) ? 'selected' : '' %>
                                                        >Ortodoncia</option>
                                                    <option value="endodoncia" <%=(perfil &&
                                                        perfil.especialidad==='endodoncia' ) ? 'selected' : '' %>
                                                        >Endodoncia</option>
                                                    <option value="periodoncia" <%=(perfil &&
                                                        perfil.especialidad==='periodoncia' ) ? 'selected' : '' %>
                                                        >Periodoncia</option>
                                                    <option value="pediatria" <%=(perfil &&
                                                        perfil.especialidad==='pediatria' ) ? 'selected' : '' %>
                                                        >Pediatría</option>
                                                    <option value="ginecologia" <%=(perfil &&
                                                        perfil.especialidad==='ginecologia' ) ? 'selected' : '' %>
                                                        >Ginecología</option>
                                                </select>
                                            </div>
                                            <% } %>

                                                <div class="col-12 mt-4">
                                                    <button type="submit" class="btn btn-primary">Guardar Datos del
                                                        Perfil</button>
                                                    <a href="/dashboard"
                                                        class="btn btn-outline-secondary ms-2">Volver</a>
                                                </div>
                                    </div>
                                </form>
                            </div>

                            <!-- TARJETA 2: HORARIOS DE ATENCIÓN (SOLO MÉDICOS CON PERFIL GUARDADO) -->
                            <% if (usuario.rol==='Medico' ) { %>
                                <div class="card border-0 shadow-sm p-4">
                                    <h4 class="fw-bold mb-1">Mis Horarios de Atención</h4>
                                    <p class="text-muted small mb-4">Define los días y turnos en los que atiendes
                                        consultas.</p>

                                    <% if (!perfil) { %>
                                        <div class="alert alert-info mb-0">
                                            Guarda primero tus datos personales arriba para poder configurar tus días y
                                            horarios de consulta.
                                        </div>
                                        <% } else { %>
                                            <!-- Formulario para agregar nuevo turno -->
                                            <form action="/perfil/horario" method="POST"
                                                class="row g-2 align-items-end mb-4">
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Día de la semana</label>
                                                    <select name="dia_semana" class="form-select" required>
                                                        <option value="Lunes">Lunes</option>
                                                        <option value="Martes">Martes</option>
                                                        <option value="Miercoles">Miércoles</option>
                                                        <option value="Jueves">Jueves</option>
                                                        <option value="Viernes">Viernes</option>
                                                        <option value="Sabado">Sábado</option>
                                                        <option value="Domingo">Domingo</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Hora inicio</label>
                                                    <input type="time" name="hora_inicio" class="form-control" required>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Hora fin</label>
                                                    <input type="time" name="hora_fin" class="form-control" required>
                                                </div>
                                                <div class="col-md-2 d-grid">
                                                    <button type="submit" class="btn btn-success">+ Agregar</button>
                                                </div>
                                            </form>

                                            <!-- Tabla de horarios registrados -->
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Día</th>
                                                            <th>Entrada</th>
                                                            <th>Salida</th>
                                                            <th class="text-end">Acción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (horarios.length===0) { %>
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted py-3">
                                                                    Aún no tienes horarios registrados.
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                                                <% horarios.forEach(h=> { %>
                                                                    <tr>
                                                                        <td class="fw-semibold">
                                                                            <%= h.dia_semana==='Miercoles' ? 'Miércoles'
                                                                                : (h.dia_semana==='Sabado' ? 'Sábado' :
                                                                                h.dia_semana) %>
                                                                        </td>
                                                                        <td>
                                                                            <%= h.hora_inicio.slice(0, 5) %> hrs
                                                                        </td>
                                                                        <td>
                                                                            <%= h.hora_fin.slice(0, 5) %> hrs
                                                                        </td>
                                                                        <td class="text-end">
                                                                            <form
                                                                                action="/perfil/horario/eliminar/<%= h.pk_horario_medico %>"
                                                                                method="POST" class="d-inline">
                                                                                <button type="submit"
                                                                                    class="btn btn-sm btn-outline-danger">Quitar</button>
                                                                            </form>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </div>
                                <% } %>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>