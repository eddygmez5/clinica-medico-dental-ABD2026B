<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0 text-primary">Gestión de Pacientes</h2>
                <% if (typeof usuario !=='undefined' && usuario.rol==='Recepcionista' ) { %>
                    <a href="/pacientes/crear" class="btn btn-primary">+ Nuevo Paciente</a>
                    <% } %>
            </div>

            <% if (exito) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= exito %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <% } %>

                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0 text-primary">Listado de Pacientes</h5>
                                </div>
                                <div class="card-body">
                                    <% if (pacientes.length===0) { %>
                                        <p class="text-muted fst-italic mb-0">No hay pacientes registrados todavía.</p>
                                        <% } else { %>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Nombre completo</th>
                                                            <th>Teléfono</th>
                                                            <th>Correo</th>
                                                            <th class="text-end">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% pacientes.forEach(p=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= p.pk_paciente %>
                                                                </td>
                                                                <td class="fw-semibold">
                                                                    <%= p.nombre %>
                                                                        <%= p.apellido %>
                                                                </td>
                                                                <td>
                                                                    <%= p.telefono || '-' %>
                                                                </td>
                                                                <td>
                                                                    <%= p.email || '-' %>
                                                                </td>
                                                                <td class="text-end">
                                                                    <a href="/pacientes/expediente/<%= p.pk_paciente %>"
                                                                        class="btn btn-info btn-sm text-white">Expediente</a>
                                                                    <% if (typeof usuario !=='undefined' &&
                                                                        usuario.rol==='Recepcionista' ) { %>
                                                                        <a href="/pacientes/editar/<%= p.pk_paciente %>"
                                                                            class="btn btn-outline-secondary btn-sm">Editar</a>
                                                                        <% } %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </div>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="card shadow-sm h-100">
                                        <div class="card-header bg-white">
                                            <h5 class="mb-0 text-primary">Catálogo de Enfermedades</h5>
                                        </div>
                                        <div class="card-body">
                                            <form action="/pacientes/catalogos/enfermedad" method="POST"
                                                class="input-group mb-3">
                                                <input type="text" name="nombre" class="form-control"
                                                    placeholder="Ej. Diabetes, Hipertensión..." required maxlength="30">
                                                <button type="submit" class="btn btn-primary">Agregar</button>
                                            </form>
                                            <div class="d-flex flex-wrap gap-2">
                                                <% enfermedades.forEach(e=> { %>
                                                    <span
                                                        class="badge rounded-pill text-bg-light border text-primary px-3 py-2">
                                                        <%= e.nombre %>
                                                    </span>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card shadow-sm h-100">
                                        <div class="card-header bg-white">
                                            <h5 class="mb-0 text-primary">Catálogo de Alergias</h5>
                                        </div>
                                        <div class="card-body">
                                            <form action="/pacientes/catalogos/alergia" method="POST"
                                                class="input-group mb-3">
                                                <input type="text" name="nombre" class="form-control"
                                                    placeholder="Ej. Penicilina, Látex..." required maxlength="30">
                                                <button type="submit" class="btn btn-primary">Agregar</button>
                                            </form>
                                            <div class="d-flex flex-wrap gap-2">
                                                <% alergias.forEach(a=> { %>
                                                    <span
                                                        class="badge rounded-pill text-bg-light border text-primary px-3 py-2">
                                                        <%= a.nombre %>
                                                    </span>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
        </main>

        <%- include('../partials/footer') %>