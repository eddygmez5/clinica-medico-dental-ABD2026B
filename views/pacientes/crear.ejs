<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= paciente ? 'Editar Paciente' : 'Nuevo Paciente' %> - Clínica Médico-Dental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/dashboard">Clínica Médico-Dental</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/dashboard">Inicio</a>
                <a class="nav-link active" href="/pacientes">Pacientes</a>
                <a class="nav-link" href="/logout">Cerrar sesión</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 text-primary"><%= paciente ? 'Editar Paciente' : 'Registrar Nuevo Paciente' %></h2>
            <a href="/pacientes" class="btn btn-outline-secondary">Volver a la lista</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form action="<%= paciente ? '/pacientes/editar/' + paciente.pk_paciente : '/pacientes/crear' %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="nombre" class="form-label fw-semibold">Nombre *</label>
                            <input type="text" id="nombre" name="nombre" class="form-control" required maxlength="30" value="<%= paciente ? paciente.nombre : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="apellido" class="form-label fw-semibold">Apellido *</label>
                            <input type="text" id="apellido" name="apellido" class="form-control" required maxlength="30" value="<%= paciente ? paciente.apellido : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="fecha_nacimiento" class="form-label fw-semibold">Fecha de nacimiento</label>
                            <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" class="form-control" value="<%= paciente && paciente.fecha_nacimiento ? new Date(paciente.fecha_nacimiento).toISOString().split('T')[0] : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="sexo" class="form-label fw-semibold">Sexo</label>
                            <select id="sexo" name="sexo" class="form-select">
                                <option value="">Seleccionar...</option>
                                <option value="Masculino" <%= paciente && paciente.sexo === 'Masculino' ? 'selected' : '' %>>Masculino</option>
                                <option value="Femenino" <%= paciente && paciente.sexo === 'Femenino' ? 'selected' : '' %>>Femenino</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="telefono" class="form-label fw-semibold">Teléfono</label>
                            <input type="text" id="telefono" name="telefono" class="form-control" maxlength="30" value="<%= paciente ? (paciente.telefono || '') : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="email" class="form-label fw-semibold">Correo electrónico</label>
                            <input type="email" id="email" name="email" class="form-control" maxlength="40" value="<%= paciente ? (paciente.email || '') : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="direccion" class="form-label fw-semibold">Dirección</label>
                            <input type="text" id="direccion" name="direccion" class="form-control" maxlength="60" value="<%= paciente ? (paciente.direccion || '') : '' %>">
                        </div>

                        <div class="col-md-6">
                            <label for="contacto_emergencia" class="form-label fw-semibold">Contacto de emergencia</label>
                            <input type="text" id="contacto_emergencia" name="contacto_emergencia" class="form-control" maxlength="60" value="<%= paciente ? (paciente.contacto_emergencia || '') : '' %>">
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><%= paciente ? 'Guardar cambios' : 'Registrar paciente' %></button>
                        <a href="/pacientes" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>