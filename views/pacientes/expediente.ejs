<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expediente Clínico - <%= paciente.nombre %> <%= paciente.apellido %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/dashboard">Clínica Médico-Dental</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/dashboard">Inicio</a>
                <a class="nav-link active" href="/pacientes">Pacientes</a>
                <a class="nav-link" href="/logout">Cerrar sesión</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 text-primary">Expediente: <%= paciente.nombre %> <%= paciente.apellido %></h2>
            <a href="/pacientes" class="btn btn-outline-secondary">Volver a Pacientes</a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 text-primary">Datos Generales</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><strong>Sexo:</strong> <%= paciente.sexo || 'No especificado' %></div>
                    <div class="col-md-4"><strong>Teléfono:</strong> <%= paciente.telefono || 'No especificado' %></div>
                    <div class="col-md-4"><strong>Correo:</strong> <%= paciente.email || 'No especificado' %></div>
                    <div class="col-md-6"><strong>Dirección:</strong> <%= paciente.direccion || 'No especificada' %></div>
                    <div class="col-md-6"><strong>Contacto de emergencia:</strong> <%= paciente.contacto_emergencia || 'No especificado' %></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 text-primary">Enfermedades Registradas</h5>
                    </div>
                    <div class="card-body">
                        <form action="/pacientes/expediente/<%= paciente.pk_paciente %>/enfermedad" method="POST" class="mb-4">
                            <div class="mb-3">
                                <label for="fk_enfermedad" class="form-label fw-semibold">Seleccionar enfermedad</label>
                                <select id="fk_enfermedad" name="fk_enfermedad" class="form-select" required>
                                    <option value="">-- Elige una opción --</option>
                                    <% catalogoEnfermedades.forEach(e => { %>
                                        <option value="<%= e.pk_enfermedad %>"><%= e.nombre %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="es_cronica" name="es_cronica">
                                <label class="form-check-label" for="es_cronica">¿Es una enfermedad crónica?</label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Asignar enfermedad</button>
                        </form>

                        <hr>

                        <% if (enfermedadesPaciente.length === 0) { %>
                            <p class="text-muted fst-italic mb-0">Sin enfermedades registradas.</p>
                        <% } else { %>
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Enfermedad</th>
                                        <th>Tipo</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% enfermedadesPaciente.forEach(ep => { %>
                                        <tr>
                                            <td><%= ep.nombre %></td>
                                            <td>
                                                <span class="badge <%= ep.es_cronica ? 'text-bg-warning' : 'text-bg-secondary' %>">
                                                    <%= ep.es_cronica ? 'Crónica' : 'No crónica' %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <form action="/pacientes/expediente/<%= paciente.pk_paciente %>/enfermedad/<%= ep.pk_enfermedad %>/eliminar" method="POST">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 text-primary">Alergias Registradas</h5>
                    </div>
                    <div class="card-body">
                        <form action="/pacientes/expediente/<%= paciente.pk_paciente %>/alergia" method="POST" class="mb-4">
                            <div class="mb-3">
                                <label for="fk_alergia" class="form-label fw-semibold">Seleccionar alergia</label>
                                <select id="fk_alergia" name="fk_alergia" class="form-select" required>
                                    <option value="">-- Elige una opción --</option>
                                    <% catalogoAlergias.forEach(a => { %>
                                        <option value="<%= a.pk_alergia %>"><%= a.nombre %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="gravedad" class="form-label fw-semibold">Gravedad</label>
                                <select id="gravedad" name="gravedad" class="form-select" required>
                                    <option value="leve">Leve</option>
                                    <option value="moderada">Moderada</option>
                                    <option value="severa">Severa</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Asignar alergia</button>
                        </form>

                        <hr>

                        <% if (alergiasPaciente.length === 0) { %>
                            <p class="text-muted fst-italic mb-0">Sin alergias registradas.</p>
                        <% } else { %>
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Alergia</th>
                                        <th>Gravedad</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% alergiasPaciente.forEach(ap => { %>
                                        <tr>
                                            <td><%= ap.nombre %></td>
                                            <td>
                                                <span class="badge <%= ap.gravedad === 'severa' ? 'text-bg-danger' : (ap.gravedad === 'moderada' ? 'text-bg-warning' : 'text-bg-success') %> text-uppercase">
                                                    <%= ap.gravedad %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <form action="/pacientes/expediente/<%= paciente.pk_paciente %>/alergia/<%= ap.pk_alergia %>/eliminar" method="POST">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>